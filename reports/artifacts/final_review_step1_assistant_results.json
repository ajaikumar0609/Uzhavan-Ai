     "timestamp": "2026-11-08T07:14:06.848154+00:00",
     "data": {
      "answer": "\u0baa\u0bbf\u0bb0\u0bcb\u0b83\u0b9f\u0bbe\u0bb8\u0bcd\u0ba8\u0bc8\u0ba4\u0bbf \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0bb5\u0bbf\u0ba4\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0baf\u0bc8 \u0b95\u0bb5\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0b85\u0bb3\u0bb5\u0b9f\u0bc8\u0baa\u0bcd\u0baa\u0bc1, \u0b87\u0bb2\u0bc8\u0ba4\u0bcd\u0ba4\u0bca\u0bb4\u0bbf\u0bb2\u0bcd \u0bb5\u0b9a\u0ba4\u0bbf \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bb1\u0bcd\u0bb1\u0bae\u0ba9\u0bcd\u0ba9\u0b99\u0bcd\u0b95\u0bc1 \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba8\u0b9f\u0bc8\u0baa\u0bcb\u0ba4\u0bc1\u0bae\u0bcd. \u0b87\u0ba4\u0bc1 \u0b92\u0bb0\u0bc1 \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb3\u0bbf \u0bb5\u0bb4\u0bb5\u0b9a\u0bcd \u0b9a\u0bc6\u0baf\u0bb2\u0bbe\u0b95, \u0ba4\u0bc1\u0bb1\u0bc8 \u0b89\u0bb0\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0baa\u0bcd \u0baa\u0b9e\u0bcd\u0b9a\u0bae\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd. \u0b87\u0ba9\u0bbf\u0baf \u0bb5\u0bbf\u0ba4\u0bc8 \u0b85\u0ba3\u0bbf (chlorophyll) \u0b8e\u0ba9\u0bcd\u0bb1 \u0b92",
      "spoken_text": "\u0baa\u0bbf\u0bb0\u0bcb\u0b83\u0b9f\u0bbe\u0bb8\u0bcd\u0ba8\u0bc8\u0ba4\u0bbf \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0bb5\u0bbf\u0ba4\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0baf\u0bc8 \u0b95\u0bb5\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0b85\u0bb3\u0bb5\u0b9f\u0bc8\u0baa\u0bcd\u0baa\u0bc1, \u0b87\u0bb2\u0bc8\u0ba4\u0bcd\u0ba4\u0bca\u0bb4\u0bbf\u0bb2\u0bcd \u0bb5\u0b9a\u0ba4\u0bbf \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bb1\u0bcd\u0bb1\u0bae\u0ba9\u0bcd\u0ba9\u0b99\u0bcd\u0b95\u0bc1 \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba8\u0b9f\u0bc8\u0baa\u0bcb\u0ba4\u0bc1\u0bae\u0bcd. \u0b87\u0ba4\u0bc1 \u0b92\u0bb0\u0bc1 \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb3\u0bbf \u0bb5\u0bb4\u0bb5\u0b9a\u0bcd \u0b9a\u0bc6\u0baf\u0bb2\u0bbe\u0b95, \u0ba4\u0bc1\u0bb1\u0bc8 \u0b89\u0bb0\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0baa\u0bcd \u0baa\u0b9e\u0bcd\u0b9a\u0bae\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd. \u0b87\u0ba9\u0bbf\u0baf \u0bb5\u0bbf\u0ba4\u0bc8 \u0b85\u0ba3\u0bbf (chlorophyll) \u0b8e\u0ba9\u0bcd\u0bb1 \u0b92",
