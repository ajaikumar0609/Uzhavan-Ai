<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- INTERNET: API calls + Flutter tooling (hot reload, breakpoints). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug/profile only: allow plain http to a local backend
         (e.g. http://10.0.2.2:8000 from the Android emulator).
         The release manifest keeps cleartext traffic disabled. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
