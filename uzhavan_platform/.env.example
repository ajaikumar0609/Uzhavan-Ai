# ============================================================================
# UZHAVAN AI backend: environment variables (generated from backend/shared/settings.py)
# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# The settings module validates everything at start-up and refuses unsafe config.
# Set ENV_FILE=/path/to/file to load a different env file, or ENV_FILE=none to load none.
# ============================================================================

# ─── Core ───────────────────────────────────────────────────────────────────
# REQUIRED, no default: development | test | production
ENV=development
# REQUIRED. Production: >= 32 chars, not a placeholder.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Required in production. Example: postgresql://user@127.0.0.1:5432/uzhavan_dev
DATABASE_URL=
# Required in production. Example: redis://127.0.0.1:6379/0
REDIS_URL=
# Comma-separated. Required in production. Development default when unset:
# http://localhost:5173,http://localhost:5180,http://127.0.0.1:5180,http://10.0.2.2:8000,https://localhost,capacitor://localhost
CORS_ORIGINS=
# Optional. Default: true in development/test, false in production. Must be false in production.
ALLOW_ANONYMOUS=

# ─── Auth / OTP (FP-008) ────────────────────────────────────────────────────
# Log OTPs to the server log. Honoured ONLY when ENV=development. Must not be true in production.
OTP_DEV_LOG=false
# Optional HMAC key for OTP hashes. Default: derived from JWT_SECRET.
OTP_HMAC_KEY=
# none | msg91 | twilio. Production with "none" (or missing credentials) -> send-otp returns 503.
# NOTE: msg91/twilio are stubs; no external SMS API is called yet.
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── LLM (backend/cognitive/llm/service.py) ─────────────────────────────────
# ollama ONLY (local Qwen2.5). Zero-paid-API policy: no Claude/OpenAI/Gemini or other external AI.
LLM_PROVIDER=ollama
OLLAMA_HOST=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
LLM_TIMEOUT_S=60

# ─── RAG ────────────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
CHROMA_PATH=./rag/chroma
TOP_K_RETRIEVAL=6
RAG_SCORE_THRESHOLD=0.35
KNOWLEDGE_BASE=./knowledge/tnau

# ─── Versions (stored with every conversation turn) ─────────────────────────
AI_VERSION=0.1.0
GRAPH_VERSION=1.0.0
PROMPT_VERSION=1
RAG_VERSION=1
EMBEDDING_VERSION=1.0

# ─── Disease detection / voice ──────────────────────────────────────────────
DISEASE_SERVICE_URL=http://localhost:8001
DISEASE_TIMEOUT_S=15
# browser-only | openai | local
WHISPER_PROVIDER=browser-only
# gtts | google | browser-only
TTS_PROVIDER=browser-only

# ─── Feature flags ──────────────────────────────────────────────────────────
ENABLE_WEATHER=true
ENABLE_DISEASE=true
ENABLE_SCHEMES=true
ENABLE_MARKET=true
ENABLE_SATELLITE=false
ENABLE_MEMORY=true
ENABLE_MCP=false
ENABLE_STREAMING=true
